{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Information",
        "Taurus": "Information"
      }
    },
    "WriteTo": {
      "Sink": {
        "Name": "File",
        "Args": {
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "fileSizeLimitBytes": 10485760
        }
      }
    },
    "Enrich": [
      "FromLogContext"
    ]
  }
}