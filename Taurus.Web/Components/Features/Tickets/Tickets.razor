@page "/"
@page "/tickets"

<PageTitle>Tickets</PageTitle>

<div class="tickets-page">
    <div class="tickets-listing">
        <div class="p-3 tickets-heading">
            <MudText Typo="Typo.h4"
                     HtmlTag="h1">
                @SelectedProjectTitle
            </MudText>

            @if (CanCreateTicket)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="CreateTicketAsync">
                    Create Ticket
                </MudButton>
            }
            else
            {
                <MudTooltip Text="Select a project to create a ticket.">
                    <span class="create-ticket-disabled">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   Disabled>
                            Create Ticket
                        </MudButton>
                    </span>
                </MudTooltip>
            }
        </div>

        <div class="d-block d-md-none px-3 mb-4">
            <MudGrid Spacing="3">
                <MudItem xs="12" sm="6">
                    <MudSelect T="Guid"
                               Value="@SelectedProjectListValue"
                               ValueChanged="SelectedProjectChangedAsync"
                               Label="Project"
                               Variant="Variant.Outlined">
                        <MudSelectItem T="Guid"
                                       Value="@AllProjectsId">
                            All
                        </MudSelectItem>

                        @foreach (var project in ProjectItems)
                        {
                            <MudSelectItem T="Guid"
                                           Value="@project.Id">
                                @project.Title
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="TicketFilter"
                               Value="@SelectedTicketFilter"
                               ValueChanged="SelectedTicketFilterChangedAsync"
                               Label="Filter"
                               Variant="Variant.Outlined">
                        <MudSelectItem T="TicketFilter"
                                       Value="TicketFilter.All">
                            All Tickets
                        </MudSelectItem>

                        <MudSelectItem T="TicketFilter"
                                       Value="TicketFilter.Open">
                            Open Tickets
                        </MudSelectItem>

                        <MudSelectItem T="TicketFilter"
                                       Value="TicketFilter.Backlog">
                            Backlog Tickets
                        </MudSelectItem>

                        <MudSelectItem T="TicketFilter"
                                       Value="TicketFilter.HighPriority">
                            High Priority
                        </MudSelectItem>

                        <MudSelectItem T="TicketFilter"
                                       Value="TicketFilter.Obsolete">
                            Obsolete
                        </MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>
        </div>
        
        @if (!PagedTicketItems.Any())
        {
            <MudText Typo="Typo.body1"
                     Color="Color.Secondary"
                     Class="ticket-empty">
                No tickets
            </MudText>
        }
        else
        {
            <MudPaper Elevation="1"
                      Class="tickets-table d-none d-sm-block">
                @foreach (var ticket in PagedTicketItems)
                {
                    <div class="@GetTicketClass(ticket)"
                         role="link"
                         tabindex="0"
                         @onclick="() => OpenTicket(ticket)"
                         @onkeydown="args => TicketKeyDown(args, ticket)">

                        <MudText Typo="Typo.body2"
                                 Class="ticket-ref">
                            @ticket.TicketRef
                        </MudText>

                        <TicketStateIndicators Ticket="@ticket"
                                               LookupIds="@LookupIds"
                                               TicketStatuses="@TicketStatuses"
                                               TicketPriorities="@TicketPriorities"/>

                        <MudText Typo="Typo.body2"
                                 Class="ticket-title">
                            @ticket.Title
                        </MudText>

                        <MudText Typo="Typo.body2"
                                 Class="ticket-updated">
                            @FormatLastUpdated(ticket.LastModified)
                        </MudText>
                    </div>
                }
            </MudPaper>

            <MudPaper Elevation="1"
                      Class="mobile-ticket-list d-block d-sm-none">
                @foreach (var ticket in PagedTicketItems)
                {
                    <div class="@GetMobileTicketClass(ticket)"
                         role="link"
                         tabindex="0"
                         @onclick="() => OpenTicket(ticket)"
                         @onkeydown="args => TicketKeyDown(args, ticket)">

                        <div class="mobile-ticket-header">
                            <div class="mobile-ticket-identity">
                                <MudText Typo="Typo.body2"
                                         Class="ticket-ref">
                                    @ticket.TicketRef
                                </MudText>

                                <TicketStateIndicators Ticket="@ticket"
                                                       LookupIds="@LookupIds"
                                                       TicketStatuses="@TicketStatuses"
                                                       TicketPriorities="@TicketPriorities"/>
                            </div>

                            <MudText Typo="Typo.caption"
                                     Class="ticket-updated">
                                @FormatLastUpdated(ticket.LastModified)
                            </MudText>
                        </div>

                        <MudText Typo="Typo.body2"
                                 Class="ticket-title">
                            @ticket.Title
                        </MudText>
                    </div>
                }
            </MudPaper>
        }
        @if (PageCount > 1)
        {
            <div class="tickets-pagination">
                <MudPagination Count="@PageCount"
                               @bind-Selected="CurrentPage"
                               Color="Color.Primary"/>
            </div>
        }
    </div>

    <aside class="tickets-filters d-none d-md-block pt-5 pl-3"
           aria-label="Ticket filters">
        <div class="filter-widget">
            <MudText Typo="Typo.h6"
                     Class="filter-widget-heading">
                Projects
            </MudText>

            <MudList T="Guid"
                     Dense="true"
                     SelectionMode="SelectionMode.SingleSelection"
                     SelectedValue="SelectedProjectListValue"
                     SelectedValueChanged="SelectedProjectChangedAsync"
                     Color="Color.Primary"
                     Class="filter-widget-list">

                <MudListItem T="Guid"
                             Value="@AllProjectsId">
                    All
                </MudListItem>

                @foreach (var project in ProjectItems)
                {
                    <MudListItem T="Guid"
                                 Value="@project.Id">
                        @project.Title
                    </MudListItem>
                }
            </MudList>
        </div>
        <div class="filter-widget">
            <MudText Typo="Typo.h6"
                     Class="filter-widget-heading">
                Filters
            </MudText>

            <MudList T="TicketFilter"
                     Dense="true"
                     SelectionMode="SelectionMode.SingleSelection"
                     SelectedValue="SelectedTicketFilter"
                     SelectedValueChanged="SelectedTicketFilterChangedAsync"
                     Color="Color.Primary"
                     Class="filter-widget-list">
                <MudListItem T="TicketFilter"
                             Value="TicketFilter.All">
                    All Tickets
                </MudListItem>

                <MudListItem T="TicketFilter"
                             Value="TicketFilter.Open">
                    Open Tickets
                </MudListItem>

                <MudListItem T="TicketFilter"
                             Value="TicketFilter.Backlog">
                    Backlog Tickets
                </MudListItem>

                <MudListItem T="TicketFilter"
                             Value="TicketFilter.HighPriority">
                    High Priority
                </MudListItem>

                <MudListItem T="TicketFilter"
                             Value="TicketFilter.Obsolete">
                    Obsolete
                </MudListItem>
            </MudList>
        </div>
    </aside>
</div>