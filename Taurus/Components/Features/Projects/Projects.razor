@page "/projects"

<PageTitle>Projects</PageTitle>

<MudStack Row
          AlignItems="AlignItems.Center"
          Justify="Justify.SpaceBetween"
          Class="mb-4">
    <MudText Typo="Typo.h4"
             HtmlTag="h1">
        Projects
    </MudText>

    <MudStack Row
              AlignItems="AlignItems.Center"
              Spacing="2">
        <MudCheckBox T="bool"
                     Value="@ActiveOnly"
                     ValueChanged="ActiveOnlyChangedAsync"
                     Label="Active only" />

        <MudCheckBox T="bool"
                     Value="@IncludeDeleted"
                     ValueChanged="IncludeDeletedChangedAsync"
                     Label="Include deleted" />
    </MudStack>
</MudStack>

<MudTable T="Project"
          Items="@ProjectItems"
          Hover
          Elevation="1">
    <HeaderContent>
        <MudTh>
            <MudTableSortLabel T="Project"
                               SortBy="project => project.Id">
                Id
            </MudTableSortLabel>
        </MudTh>

        <MudTh>
            <MudTableSortLabel T="Project"
                               SortBy="project => project.Title"
                               InitialDirection="SortDirection.Ascending">
                Title
            </MudTableSortLabel>
        </MudTh>

        <MudTh>
            <MudTableSortLabel T="Project"
                               SortBy="project => project.Prefix">
                Prefix
            </MudTableSortLabel>
        </MudTh>

        <MudTh>
            <MudTableSortLabel T="Project"
                               SortBy="project => project.IsActive">
                Active
            </MudTableSortLabel>
        </MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd DataLabel="Id">@context.Id</MudTd>
        <MudTd DataLabel="Title">@context.Title</MudTd>
        <MudTd DataLabel="Prefix">@context.Prefix</MudTd>
        <MudTd DataLabel="Active">
            <MudChip T="string"
                     Color="@(context.IsActive ? Color.Success : Color.Default)"
                     Variant="Variant.Filled"
                     Size="Size.Small">
                @(context.IsActive ? "Active" : "Inactive")
            </MudChip>
        </MudTd>
    </RowTemplate>
</MudTable>