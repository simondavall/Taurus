@inherits LayoutComponentBase

<MudThemeProvider Theme="@TaurusTheme.Default" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">

        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       aria-label="Toggle navigation"
                       OnClick="ToggleNavigation" />

        <MudText Typo="Typo.h5"
                 Class="taurus-app-title">
            Taurus
        </MudText>

        <MudSpacer />

        <MudIconButton Icon="@TaurusIcons.Actions.Refresh"
                       Color="Color.Inherit"
                       aria-label="Refresh page"
                       OnClick="RefreshPageAsync" />

    </MudAppBar>

    <MudDrawer @bind-Open="_navigationOpen"
               Variant="DrawerVariant.Persistent"
               Elevation="1">

        <NavMenu />

    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge"
                      Class="taurus-main-content">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>